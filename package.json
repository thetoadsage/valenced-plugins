{
	"name": "@thetoadsage/valenced-plugins",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "valenced-plugin build",
		"package": "npm run build && node scripts/package.mjs",
		"test": "npm run build && node --experimental-strip-types --test tests/*.test.ts",
		"lint": "biome check plugins scripts tests package.json repo.config.json",
		"lint:types": "tsc -p plugins/message-logger/tsconfig.json && tsc -p plugins/url-cleaner/tsconfig.json && tsc -p plugins/no-reply-mention/tsconfig.json && tsc -p plugins/silent-message-toggle/tsconfig.json && tsc -p plugins/hide-chat-buttons/tsconfig.json && tsc -p plugins/read-all-notifications/tsconfig.json",
		"generate-index": "valenced-plugin generate-index"
	},
	"dependencies": {
		"@valenced/plugin-cli": "git+https://github.com/Valenced/valenced-plugin-cli.git#9ea9f9bfc91319e2b18c6b1c9ac0b993f8600c1d",
		"@valenced/types": "https://codeload.github.com/Valenced/valenced-types/tar.gz/c67dd726d1ec28b38d8ac93862fdd3b6029b1d29",
		"react-native-url-polyfill": "4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^26.6.3",
		"@types/react": "^19.2.18",
		"fflate": "0.8.3",
		"react-native": "0.86.0",
		"typescript": "7.0.2"
	},
	"overrides": {
		"@react-native/community-cli-plugin": "npm:dry-uninstall",
		"@react-native/codegen": "npm:dry-uninstall",
		"babel-jest": "npm:dry-uninstall",
		"babel-plugin-syntax-hermes-parser": "npm:dry-uninstall",
		"hermes-compiler": "npm:dry-uninstall",
		"jsc-android": "npm:dry-uninstall",
		"react-devtools-core": "npm:dry-uninstall",
		"recyclerlistview": "npm:dry-uninstall",
		"react-native-gesture-handler": "npm:dry-uninstall",
		"react-native-screens": "npm:dry-uninstall",
		"@valenced/types": "$@valenced/types"
	}
}
