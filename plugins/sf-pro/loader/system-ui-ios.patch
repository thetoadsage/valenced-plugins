 - (UIFont *)fontWithPostScript:(NSString *)postScript cascade:(nullable NSArray *)cascade size:(CGFloat)size {
+    if ([postScript isEqualToString:VTHSystemUIFont]) {
+        UIFontDescriptor *requested = cascade.firstObject;
+        NSString *name = requested.postscriptName;
+        NSDictionary *traits = requested.fontAttributes[UIFontDescriptorTraitsAttribute];
+        NSNumber *weight = traits[UIFontWeightTrait];
+        NSNumber *slant = traits[UIFontSlantTrait];
+        CGFloat pointSize = size > 0 ? size : requested.pointSize;
+        if (pointSize <= 0) pointSize = UIFont.systemFontSize;
+        UIFont *font = [UIFont systemFontOfSize:pointSize weight:VTHSystemUIFontWeight(name, weight)];
+        BOOL italic = [name hasSuffix:@"Italic"] || (requested.symbolicTraits & UIFontDescriptorTraitItalic) || slant.doubleValue != 0;
+        if (!italic) return font;
+        UIFontDescriptor *descriptor = [font.fontDescriptor fontDescriptorWithSymbolicTraits:
+            font.fontDescriptor.symbolicTraits | UIFontDescriptorTraitItalic];
+        if (!descriptor) return font;
+        return ((UIFont * (*)(id, SEL, UIFontDescriptor *, CGFloat))self.fontWithDescriptorOriginal)(
+            [UIFont class], @selector(fontWithDescriptor:size:), descriptor, pointSize);
+    }
